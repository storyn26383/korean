---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SSY 韓文筆記',
  description = '以 Markdown 整理嘅韓文筆記。',
} = Astro.props;

const pageTitle = title === 'SSY 韓文筆記' ? title : `${title} | SSY 韓文筆記`;
const homeUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f1e9" />
    <script is:inline>
      (() => {
        let savedTheme = null;

        try {
          savedTheme = localStorage.getItem('theme');
        } catch {
          // Use the system preference when storage is unavailable.
        }

        const theme = savedTheme === 'light' || savedTheme === 'dark'
          ? savedTheme
          : window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';

        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          'content',
          theme === 'dark' ? '#111713' : '#f4f1e9',
        );
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${homeUrl}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="SSY 韓文筆記" href={`${homeUrl}rss.xml`} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Q92ZCX7Q1X"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-Q92ZCX7Q1X');
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={homeUrl}>SSY 韓文筆記</a>
      <div class="site-actions">
        <nav aria-label="主要導覽">
          <a class="site-nav-link" href={`${homeUrl}tags/`}>分類</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="切換至深色模式" title="切換至深色模式">
          <span class="theme-toggle-icon" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>Built with Astro</span>
      <a href={`${homeUrl}rss.xml`}>RSS</a>
    </footer>

    <script is:inline>
      const themeToggle = document.querySelector('.theme-toggle');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');

      function updateThemeToggle() {
        const isDark = document.documentElement.dataset.theme === 'dark';
        const label = isDark ? '切換至淺色模式' : '切換至深色模式';

        themeToggle?.setAttribute('aria-label', label);
        themeToggle?.setAttribute('title', label);
        themeToggle?.setAttribute('aria-pressed', String(isDark));
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          'content',
          isDark ? '#111713' : '#f4f1e9',
        );
      }

      themeToggle?.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';

        document.documentElement.dataset.theme = nextTheme;

        try {
          localStorage.setItem('theme', nextTheme);
        } catch {
          // The current page still changes theme when storage is unavailable.
        }

        updateThemeToggle();
      });

      systemTheme.addEventListener('change', (event) => {
        let savedTheme = null;

        try {
          savedTheme = localStorage.getItem('theme');
        } catch {
          // Continue following the system preference without storage.
        }

        if (savedTheme !== 'light' && savedTheme !== 'dark') {
          document.documentElement.dataset.theme = event.matches ? 'dark' : 'light';
          updateThemeToggle();
        }
      });

      updateThemeToggle();

      for (const link of document.querySelectorAll('a[href]')) {
        try {
          const url = new URL(link.getAttribute('href'), window.location.href);
          const isWebLink = url.protocol === 'http:' || url.protocol === 'https:';

          if (isWebLink && url.origin !== window.location.origin) {
            link.setAttribute('target', '_blank');
            link.setAttribute('rel', 'noopener noreferrer');
          }
        } catch {
          // Leave malformed or unsupported links unchanged.
        }
      }
    </script>
  </body>
</html>
