---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  emptyMessage?: string;
}

const { posts, emptyMessage = '暫時未有文章。' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

{
  posts.length === 0 ? (
    <p class="empty-state">{emptyMessage}</p>
  ) : (
    <ol class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`${baseUrl}posts/${post.id}/`}>
            <span>{post.data.title}</span>
            <time datetime={post.data.publishedAt.toISOString()}>
              {post.data.publishedAt.toLocaleDateString('zh-HK')}
            </time>
          </a>
          <p>{post.data.description}</p>
          <ul class="tag-list post-tags" aria-label="文章標籤">
            {post.data.tags.map((tag) => (
              <li>
                <a class="tag" href={`${baseUrl}tags/${encodeURIComponent(tag)}/`}>{tag}</a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  )
}
